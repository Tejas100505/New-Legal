# Agentic AI E-Discovery & Legal Review — Environment Configuration
# Copy this file to .env and replace placeholders with secure, actual values.

# ── Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace_with_a_secure_random_secret_key_64_bytes_long

# ── Authentication & Security
AUTH_PROVIDER=local
JWT_SECRET_KEY=replace_with_a_strong_random_jwt_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ediscovery
DATABASE_PASSWORD=replace_with_secure_postgres_password
DATABASE_NAME=ediscovery_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# DATABASE_URL=postgresql+asyncpg://ediscovery:password@localhost:5432/ediscovery_db

# ── Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── AI / LLM Model Keys
LLM_PROVIDER=google
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_MODEL=gemini-3.6-flash

# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Embeddings & OCR Configuration
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

OCR_PRIMARY_ENGINE=paddleocr
OCR_FALLBACK_ENGINES=tesseract,easyocr

# ── File Storage & Limits
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
