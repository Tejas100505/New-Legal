docker-compose.override.yml

# ── Application Data ─────────────────────────────────────────────────────────
uploads/
*.pdf
*.docx
*.eml
logs/
*.log

# ── Database ──────────────────────────────────────────────────────────────────
pgdata/
*.db
*.sqlite
*.sqlite3

# ── Vector Stores ─────────────────────────────────────────────────────────────
*.faiss
*.pkl
chroma_db/

